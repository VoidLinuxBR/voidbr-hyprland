pkgname=voidbr-hyprland
pkgdesc="VoidBR HYPRLAND Meta Package"
pkgver=$(date +%Y%m%d)
pkgrel=$(date +%H%M)
provides=()
replaces=()
arch=('any')
license=('MIT')
#url="ssh://git@github.com/voidlinuxbr/${pkgname}"
url="https://github.com/voidlinuxbr/${pkgname}"
source=("git+${url}.git")
md5sums=('SKIP')
makedepends=()
depends=(
	voidbr-base-common
	voidbr-wayland-common
	voidbr-gui-common
	cliphist               # Histórico da área de transferência
	engrampa               # Gerenciador de arquivos compactados
	eom                    # Visualizador de imagens (Eye of MATE)
	foot                   # Terminal leve e otimizado para Wayland
	gnome-system-monitor   # Process viewer and system resource monitor for GNOME
	grim                   # Utilitário para captura de tela (screenshot)
	hyprcursor             # Formato de cursor nativo do Hyprland
	hypridle               # Gerenciador de inatividade (idle) do Hyprland
	hyprland               # Compositor Wayland principal
	hyprlauncher           # Lançador de aplicativos nativo do Hyprland
	hyprlock               # Bloqueador de tela nativo do Hyprland
	hyprpaper              # Wallpaper daemon para Hyprland
	'hyprpicker>=0.4.7_3'  # Seletor de cores para Wayland
	hyprshot               # Utility to easily take screenshots in Hyprland using your mouse
	hyprsysteminfo         # A tiny qt6/qml application to display information about the running system
	kanshi                 # Gerenciador dinâmico de monitores
	mako                   # Servidor de notificações Wayland
	slurp                  # Seleção de área para captura de tela
	swappy                 # Wayland native snapshot editing tool, inspired by Snappy on macOS
	Thunar                 # Gerenciador de arquivos (XFCE)
	thunar-archive-plugin  # Integração de compactação no Thunar
	Waybar                 # Barra de status customizável para Wayland
	wl-clipboard           # Ferramentas de clipboard (wl-copy/wl-paste)
	wlogout                # Wayland based logout menu
	wmenu                  # Menu de seleção estilo dmenu/wofi para Wayland
	wofi                   # Lançador de aplicativos e menu de busca
	nwg-bar                # GTK3-based button bar for wlroots-based compositors
	nwg-launchers          # GTK-based launchers for window managers
	nwg-look               # GTK settings editor adapted to work in the wlroots environment
	voidbr-hyprland-config # Skel config for Void Linux HYPRLAND Meta Package
)
backup=()

package() {
	# Verify default folder
	if [ -d "${srcdir}/${pkgname}/${pkgname}" ]; then
		InternalDir="${srcdir}/${pkgname}/${pkgname}"
	elif [ -d "${srcdir}/${pkgname}" ]; then
		InternalDir="${srcdir}/${pkgname}"
	else
		#local
		InternalDir="${WORKDIR}"
	fi

	cd "${InternalDir}"
	# Copiar a estrutura de /etc, /usr e /opt para /
	local dirs=("boot" "etc" "opt" "usr" "var")
	for dir in "${dirs[@]}"; do
		if [ -d "${InternalDir}/${dir}" ]; then
			cp -a "${InternalDir}/${dir}" "${pkgdir}/"
		fi
	done

	# Install license file if present
	[ -f "LICENSE" ] && install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
	# Install documentation if present
	[ -f "README.md" ] && install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"

}

pre_install() {
	log "Iniciando instalação"
}

post_install() {
	if [ "${update:-}" = "yes" ]; then
		log "Finalizando upgrade"
	else
		log "Finalizando instalação"
	fi

	if [ -n "${MKISO_BUILD:-}" ]; then
		echo "${YELLOW}[-]${RESET} Build de ISO detectado (MKISO_BUILD) — pulando."
		return 0
	fi

	if [ -z "${VOIDBR_INSTALLER:-}" ]; then
		if [ -n "$user" ]; then
			log "Aplicando configuracoes para $user"
			/usr/local/bin/voidbr-copy-skel-inc --user "$user" --force --quiet || true
		fi

		log "Ativando serviços"
		/usr/local/bin/vservice add sddm --quiet || true
	fi

	log "${YELLOW}Instalação completa. Reinicie o sistema...${RESET}"
}

pre_upgrade() {
	log "Iniciando upgrade"
}

post_upgrade() {
	post_install
}
